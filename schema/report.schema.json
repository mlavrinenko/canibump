{
  "$defs": {
    "Row": {
      "description": "One blocker in the `--json` document.",
      "properties": {
        "checked_at": {
          "description": "When it was checked, RFC 3339.",
          "type": "string"
        },
        "detail": {
          "description": "Why.",
          "type": "string"
        },
        "fresh_until": {
          "description": "Until when the result is reused, RFC 3339.",
          "type": "string"
        },
        "id": {
          "description": "The blocker id.",
          "type": "string"
        },
        "note": {
          "description": "The blocker note.",
          "type": "string"
        },
        "sites": {
          "description": "Where its workaround sits: each `canibump:<id>` `[scan]` found.",
          "items": {
            "$ref": "#/$defs/Site"
          },
          "type": "array"
        },
        "stale": {
          "description": "Past `fresh_until`.",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "description": "What the check found."
        }
      },
      "required": [
        "id",
        "note",
        "status",
        "detail",
        "checked_at",
        "fresh_until",
        "sites",
        "stale"
      ],
      "type": "object"
    },
    "Site": {
      "description": "A line of a scanned file holding a blocker's marker.",
      "properties": {
        "file": {
          "description": "The file, relative to the manifest's directory.",
          "type": "string"
        },
        "line": {
          "description": "The 1-based line.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file",
        "line"
      ],
      "type": "object"
    },
    "Status": {
      "description": "The state of a blocker, or of one step of it.",
      "oneOf": [
        {
          "const": "waiting",
          "description": "Upstream has not landed it yet.",
          "type": "string"
        },
        {
          "const": "bumpable",
          "description": "Landed: the workaround can go.",
          "type": "string"
        },
        {
          "const": "dead",
          "description": "Will not land as declared (closed unmerged, wontfix, duplicate).",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "The check itself failed (network, auth, rate limit).",
          "type": "string"
        }
      ]
    },
    "Unlisted": {
      "description": "An upstream link no blocker lists, in the `--json` document.",
      "properties": {
        "catcher": {
          "description": "The catcher that found it.",
          "type": "string"
        },
        "file": {
          "description": "The file, relative to the manifest's directory.",
          "type": "string"
        },
        "line": {
          "description": "The 1-based line.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "ref": {
          "description": "The link as a manifest ref.",
          "type": "string"
        }
      },
      "required": [
        "file",
        "line",
        "ref",
        "catcher"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The `--json` document.",
  "properties": {
    "cache": {
      "description": "The state file holding these results.",
      "type": "string"
    },
    "entries": {
      "description": "One row per blocker.",
      "items": {
        "$ref": "#/$defs/Row"
      },
      "type": "array"
    },
    "exit_code": {
      "description": "The process exit code these results map to.",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "manifest": {
      "description": "The manifest checked.",
      "type": "string"
    },
    "unlisted": {
      "description": "One row per upstream link or marker `[scan]` found that no blocker\nnames.",
      "items": {
        "$ref": "#/$defs/Unlisted"
      },
      "type": "array"
    },
    "unmarked": {
      "description": "The blockers `[scan]` found no `canibump:<id>` for.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "manifest",
    "cache",
    "exit_code",
    "entries",
    "unlisted",
    "unmarked"
  ],
  "title": "Report",
  "type": "object"
}
